{
  "manifest_version": 3,
  "name": "UG Voice Control",
  "version": "1.0",
  "description": "Voice control for Ultimate Guitar: search songs and scroll tabs using your voice.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "css": ["content.css"],
      "js": ["storageService.js", "spotifyService.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
