{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1",
  "key": "",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "identity"
  ],
  "oauth2": {
    "client_id": "914231993900-dqqsidnt20jhs16bsu6p3ecqth7suq6r.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.ultimate-guitar.com/*",
        "*://*.youtube.com/*",
        "*://www.google.com/search*"
      ],
      "css": ["content.css"],
      "js": [
        "storageService.js",
        "core.js",
        "voiceEngine.js",
        "widgets/floatingBar.js",
        "widgets/floatingButton.js",
        "widgets/scroll.js",
        "widgets/metronome.js",
        "widgets/tuner.js",
        "widgets/chordDetector.js",
        "widgets/repertoireDrawer.js",
        "widgets/youtubeController.js",
        "widgets/singingTracker.js",
        "widgets/pianoKeyboard.js",
        "widgets/onboarding.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "popup.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
