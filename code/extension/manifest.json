{
  "manifest_version": 3,
  "name": "UG Voice Control",
  "version": "1.0",
  "description": "Voice control for Ultimate Guitar: search songs and scroll tabs using your voice.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.ultimate-guitar.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.ultimate-guitar.com/*"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
